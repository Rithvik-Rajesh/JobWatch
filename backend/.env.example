# Copy to backend/.env (never commit .env). All variables are prefixed JOBWATCH_.
JOBWATCH_ENV=development
JOBWATCH_DATABASE_URL=postgresql+asyncpg://jobwatch:jobwatch@127.0.0.1:5433/jobwatch
JOBWATCH_ADMIN_USERNAME=admin
# uv run python -m app.core.auth hash-password
JOBWATCH_ADMIN_PASSWORD_HASH=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JOBWATCH_SESSION_SECRET=
JOBWATCH_CAPTURE_TOKEN=
JOBWATCH_CORS_ORIGINS=["http://localhost:5173"]
JOBWATCH_LOG_JSON=false
